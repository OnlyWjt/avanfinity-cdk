# 复制为 .env 后修改。直接运行（npm start）和 Docker Compose 都读这个文件

# 监听端口 / 地址：只对直接运行生效。Docker 里固定为容器内 0.0.0.0:8080，宿主机端口用下面的 APP_PORT 改
PORT=8080
HOST=0.0.0.0

# 对外访问地址（用于生成 Webhook 接收地址、支付回调、邮件链接），例如 https://cdk.example.com
PUBLIC_URL=http://localhost:8080

# 32 字节主密钥（64 位十六进制），用于加密兑换码、卡台密钥。必须备份，丢失后已加密数据无法解密
# 生产环境（PUBLIC_URL 是 https 或 NODE_ENV=production）不设置会拒绝启动
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# 反向代理：Nginx / Caddy 后面设为 1（取 X-Forwarded-For 最右一跳，国家取 X-Country-Code）；Cloudflare 后面设为 cf（取 CF-Connecting-IP / CF-IPCountry）
TRUST_PROXY=0

# HTTPS 部署时设为 1（登录 cookie 只通过 HTTPS 发送）
COOKIE_SECURE=0

# 卡台站点根地址（也可以在后台「设置」里填写）
AVAN_BASE_URL=

# 业务时区（兑换时段、每日统计按这个时区）
TZ_BUSINESS=Asia/Shanghai

# ---------------- 数据库 ----------------
# 留空：SQLite，数据库文件在 DATA_DIR/cdk.db（默认，适合单机）
# PostgreSQL：DATABASE_URL=postgres://用户:密码@主机:5432/库名
# MySQL 8.0+ / MariaDB 10.6+：DATABASE_URL=mysql://用户:密码@主机:3306/库名（库字符集 utf8mb4）
# 密码里有 @ : / # 等字符时要做 URL 编码（例如 @ 写成 %40）
DATABASE_URL=

# SQLite 的数据目录（Docker 里固定为 /data，不用改）
DATA_DIR=data

# 连接池大小（PostgreSQL / MySQL），一般不用改
# DB_POOL_SIZE=10
# 单条查询超时（毫秒）：超时报错并丢弃连接，避免一条卡住的查询挡住所有事务
# DB_QUERY_TIMEOUT_MS=30000
# 同一个库只允许一个应用实例（PostgreSQL / MySQL 用数据库锁保证）；启动时锁被占用，最多等这么多秒（等旧实例退出）
# DB_LOCK_WAIT_S=120
# 一个事务执行超过这么久：/healthz 返回 503；超过 DB_TX_STALL_EXIT_MS 进程退出，由 Docker / systemd 重启
# DB_TX_STALL_MS=60000
# DB_TX_STALL_EXIT_MS=300000

# ---------------- Docker Compose ----------------
# 用 --profile postgres 或 --profile mysql 时：数据库密码（只用字母数字最省事），并把 DATABASE_URL 指向容器：
#   DATABASE_URL=postgres://cdk:这里填DB_PASSWORD@postgres:5432/cdk
#   DATABASE_URL=mysql://cdk:这里填DB_PASSWORD@mysql:3306/cdk
DB_PASSWORD=
# MySQL root 密码（只在 --profile mysql 时需要）
DB_ROOT_PASSWORD=

# 用 --profile caddy 自动 HTTPS 时：域名（要先解析到这台服务器）
# 同时把上面改成 PUBLIC_URL=https://这个域名、TRUST_PROXY=1、COOKIE_SECURE=1
DOMAIN=

# 应用端口暴露在宿主机的哪个地址（默认只给本机的反向代理用）
# APP_BIND=127.0.0.1
# APP_PORT=8080
